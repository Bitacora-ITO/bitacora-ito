{
  "name": "bitacora-ito",
  "version": "0.2.0",
  "private": true,
  "description": "Bitácora ITO: registro en terreno y reporte diario de inspección técnica de obras",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:app": "cross-env BUILD_TARGET=capacitor next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "cap:sync": "npm run build:app && cap sync android",
    "apk": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/network": "^8.0.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  }
}
