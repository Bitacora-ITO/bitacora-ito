# Variables de entorno de Bitácora - ITO
#
# Este archivo es SOLO UN EJEMPLO y sí se sube al repositorio.
# Para trabajar: copiarlo como .env.local y reemplazar los valores.
#
#     cp .env.example .env.local
#
# .env.local está excluido en .gitignore y nunca debe subirse:
# contiene las credenciales reales.

# --- Supabase: base de datos, almacenamiento y autenticación ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave_publica_de_ejemplo
SUPABASE_SERVICE_ROLE_KEY=clave_de_servicio_de_ejemplo

# --- Servicio de IA: transcripción de voz y redacción del borrador ---
AI_API_KEY=clave_de_ejemplo
AI_MODEL=nombre_del_modelo

# --- Envío del reporte al mandante ---
MAIL_API_KEY=clave_de_ejemplo
MAIL_FROM=bitacora@empresa.cl

# --- Configuración de la aplicación ---
NEXT_PUBLIC_APP_NAME=Bitacora-ITO
NEXT_PUBLIC_APP_URL=http://localhost:3000
