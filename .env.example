# Variables de entorno de Bitácora ITO
#
# Este archivo es SOLO UN EJEMPLO y sí se sube al repositorio: no lleva valores reales.
# Para trabajar en el PC: copiarlo como .env.local y reemplazar los valores.
#
#     cp .env.example .env.local
#
# .env.local está excluido en .gitignore y nunca debe subirse: contiene las credenciales.
# En Vercel, las mismas variables se cargan en Settings > Environment Variables.
#
# OJO: las que empiezan con NEXT_PUBLIC_ quedan DENTRO de la app (web y APK) al compilar:
# cualquiera puede leerlas. Nunca poner ahí una clave secreta.
# Si cambian, hay que volver a compilar (redeploy en Vercel y `npm run apk` para el APK).

# ─── Supabase: base de datos y Storage (fotos y PDF) ───────────────────────────
# Supabase > Project Settings > API (o «Connect» > App Frameworks).
# URL del proyecto. Pública.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave «anon» / «publishable». Pública: la usa la app para sincronizar (ver riesgos en la migración).
NEXT_PUBLIC_SUPABASE_ANON_KEY=clave_anon_de_ejemplo
# Clave «service_role» / «secret». SECRETA, solo para Vercel: la función de correo la usa para
# descargar el PDF desde el bucket privado `reportes`. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=clave_de_servicio_de_ejemplo

# ─── Correo: Gmail SMTP (función /api/enviar en Vercel) ───────────────────────
# Cuenta de Gmail que envía los reportes. El remitente se ve como «Bitácora ITO <esta cuenta>».
GMAIL_USER=cuenta.de.envio@gmail.com
# Contraseña de aplicación de Google (16 letras), NO la contraseña normal de la cuenta.
# Requiere verificación en dos pasos. Se crea en https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcdabcdabcdabcd
# Destinatarios autorizados, separados por coma: correos completos o dominios.
# Evita que la función se use para mandar correo a cualquiera (relé de spam).
# Ejemplo: mandante.cl,@usach.cl,jefatura.ito@gmail.com
MAIL_DESTINATARIOS_PERMITIDOS=usach.cl,correo.de.prueba@gmail.com

# ─── Token de la aplicación ────────────────────────────────────────────────────
# La función de correo exige el encabezado x-bitacora-token igual a BITACORA_TOKEN.
# NEXT_PUBLIC_BITACORA_TOKEN es el mismo valor, que la app envía. Como va dentro de la app,
# no es un secreto fuerte: es una barrera contra llamadas casuales. La protección real es
# la lista MAIL_DESTINATARIOS_PERMITIDOS. Generar uno largo, por ejemplo con:
#     node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BITACORA_TOKEN=token_largo_al_azar
NEXT_PUBLIC_BITACORA_TOKEN=token_largo_al_azar

# ─── Dirección de la API para el APK ───────────────────────────────────────────
# El APK no tiene servidor propio: llama a la función de Vercel. Poner la URL de producción,
# sin barra final. En la web no hace falta (usa una ruta relativa).
NEXT_PUBLIC_API_URL=https://bitacora-ito.vercel.app
